doctype html
html
  head
    title Password Reset
    style.
      a{
      text-decoration: none;
      }
      button{
      color:white;
      width:15rem;
      height:3rem;
      background-color:rgb(190,82,31);
      border-radius:1em;
      border:none
      }
  body
    p Hi #{firstName},
    p
      | We received a request to reset your password. This link expires in 10 minutes.
    a(href=`${url}`, target='_blank') 
      button  RESET YOUR PASSWORD
    p If you did not request a password reset, you can ignore this email.